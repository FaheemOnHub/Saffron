# Copy to .env and fill in.
HERE_API_KEY=

# Local development only. Leave unset (false) in production.
DJANGO_DEBUG=true

# Required in production (any long random string).
DJANGO_SECRET_KEY=

# Comma-separated hostnames allowed to serve the API. Railway's own domain is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
